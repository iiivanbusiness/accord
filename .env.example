# Postgres connection string (Vercel Storage → Postgres provides this automatically)
DATABASE_URL="postgres://user:password@host/dbname?sslmode=require"

# Generate with: npx auth secret
AUTH_SECRET=""

# Public URL of the deployed app (no trailing slash)
NEXT_PUBLIC_APP_URL="https://your-domain.com"

# Google OAuth (Calendar integration) — from Google Cloud Console
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Fish Audio (fish.audio) — spoken post-call recap after a locally-recorded
# call is stopped. Optional: leave blank to keep the recap disabled.
FISH_AUDIO_API_KEY=""

# Speeds up live call extraction (deal terms + notes) from a ~60s throttle
# down to ~4s, and the companion panel's poll from 15s to 2s — for recording
# a demo where the fill-in needs to visibly track speech. Set to "1" only on
# the environment used for that recording; leave unset in production, it
# multiplies extraction-call volume (and Claude API cost) per live call by
# roughly 15x.
DEMO_FAST_EXTRACTION=""
