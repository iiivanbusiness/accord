// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Workspace {
  id                 String   @id @default(cuid())
  name               String
  plan               String   @default("Growth")
  callsUsedThisMonth Int      @default(0)
  callsLimit         Int      @default(15)
  requireApproval    Boolean  @default(true)
  notifyOnSigned     Boolean  @default(true)
  autoRemind         Boolean  @default(false)
  // How many days an unsigned contract waits before the "still unsigned"
  // nudge goes out — used to be hardcoded to 3. reminderIntervalDays only
  // matters when autoRemind is on; signingExpiryDays is independent (null
  // = never expires, matching the original no-expiry behavior) and applies
  // regardless of autoRemind.
  reminderIntervalDays Int  @default(3)
  signingExpiryDays    Int?
  zoomConnected      Boolean  @default(true)
  meetConnected      Boolean  @default(false)

  googleRefreshToken   String?
  googleAccessToken    String?
  googleTokenExpiresAt DateTime?
  googleAccountEmail   String?

  // Custom sending domain, verified with Resend, so contracts go out as
  // "you@yourcompany.com" instead of "via SealMe". senderDomainStatus mirrors
  // Resend's domain status ("pending" | "verified" | "failed") until verified.
  senderDomain       String?
  senderDomainId     String?
  senderDomainStatus String?
  senderEmail        String?

  // Base64 data URL, shown to clients on the sign page and on the contract
  // PDF instead of just the workspace name — same storage pattern as
  // Contract.signatureImage.
  logoImage String?

  // Enterprise access control. allowedEmailDomain, when set, is checked
  // against every invite and every SCIM-provisioned user — a workspace
  // locked to "acme.com" can't accidentally invite someone outside it.
  // scimTokenHash is the bearer credential an IdP's SCIM connector
  // (Okta, Azure AD/Entra) authenticates with — hashed like every other
  // long-lived credential token in this schema; the raw value is only
  // ever shown once, at generation time, in Settings.
  allowedEmailDomain String?
  scimTokenHash      String? @unique

  // OIDC single sign-on — one identity provider per workspace (Okta, Azure
  // AD/Entra, Google Workspace, or any standard OIDC issuer). Resolved by
  // matching the email domain the person types on the SSO sign-in screen
  // against allowedEmailDomain, since there's no per-workspace vanity
  // login URL. ssoClientSecret is stored plain — consistent with every
  // other field in this schema (no field-level encryption exists anywhere
  // else here); Postgres/Neon encrypts the whole database at rest.
  ssoEnabled      Boolean @default(false)
  ssoIssuer       String? // e.g. https://mycompany.okta.com
  ssoClientId     String?
  ssoClientSecret String?

  // Slack — one SealMe-owned Slack app (SLACK_CLIENT_ID/SECRET env vars,
  // shared across every workspace), installed per-workspace via OAuth.
  // slackAccessToken is the bot token (xoxb-...) that install grants;
  // there's no refresh token in Slack's model, it doesn't expire.
  // slackChannelId is picked afterward in Settings from the bot's own
  // channel list.
  slackEnabled     Boolean @default(false)
  slackTeamId      String?
  slackTeamName    String?
  slackAccessToken String?
  slackChannelId   String?
  slackChannelName String?

  // HubSpot — a per-workspace Private App token, pasted in Settings, not
  // OAuth: HubSpot disabled creating new OAuth ("public") apps outside
  // their CLI/Projects flow, so each workspace makes its own Private App
  // in its own HubSpot account (Settings -> Integrations -> Private Apps)
  // and pastes the resulting token here — same "customer supplies their
  // own long-lived credential" shape as ssoClientSecret/scimTokenHash
  // above. Private App tokens don't expire, so there's no refresh token to
  // track. One-directional (SealMe -> HubSpot) push sync only; see
  // src/lib/hubspot.ts.
  hubspotEnabled     Boolean @default(false)
  hubspotPortalId    String?
  hubspotAccessToken String?

  // DocuSign — a per-workspace OAuth connection to the WORKSPACE'S OWN
  // DocuSign account (not a SealMe-owned app installed like Slack; the
  // workspace authorizes SealMe against the DocuSign account they already
  // pay for). Lets "Send to client" hand the generated contract straight
  // to DocuSign's own envelope/signing flow instead of SealMe's built-in
  // one — see src/lib/docusign.ts. Access tokens expire (~8h) and need the
  // refresh token to renew, same pattern as googleAccessToken/
  // googleRefreshToken and hubspot's old OAuth fields above. accountId/
  // baseUri come back from DocuSign at connect time and are required on
  // every API call afterward — DocuSign accounts live on one of several
  // data-center hosts, there's no single fixed API URL.
  docusignEnabled       Boolean   @default(false)
  docusignAccessToken   String?
  docusignRefreshToken  String?
  docusignTokenExpiresAt DateTime?
  docusignAccountId     String?
  docusignBaseUri       String?
  docusignAccountEmail  String?

  createdAt          DateTime @default(now())

  users             User[]
  clients           Client[]
  deals             Deal[]
  templates         ContractTemplate[]
  calendarEvents    CalendarEvent[]
  upgradeRequests   UpgradeRequest[]
  onboardingProfile OnboardingProfile?
  auditLogs         AuditLog[]
  localCaptureTokens LocalCaptureToken[]
  roles              Role[]
  approvalChains     ApprovalChain[]
  clauseLibraryItems ClauseLibraryItem[]
  teams              Team[]
  approvalDelegates  ApprovalDelegate[]
  apiKeys            ApiKey[]
  webhookEndpoints   WebhookEndpoint[]
}

// A workspace-defined organizational unit — "Sales EMEA", "Sales US" — kept
// deliberately separate from Role: Role gates what someone can DO
// (permissions, who can approve), Team is who they're ON, and an
// ApprovalChain can be scoped to one so different teams get different
// approval rules without needing different roles. Optional everywhere it's
// referenced — a workspace that never creates a Team behaves exactly as
// before this existed.
model Team {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  createdAt   DateTime  @default(now())

  users          User[]
  deals          Deal[]
  approvalChains ApprovalChain[]

  @@unique([workspaceId, name])
}

// A canonical, reusable clause — "insert from library" into any template
// instead of retyping the same Confidentiality/Governing Law wording in
// every one. Copy-on-insert, not a live reference: inserting drops a plain
// copy into the template's own clauses JSON, so editing the library later
// doesn't silently rewrite contracts already generated from it. The point
// is giving legal one canonical place to maintain the wording and quickly
// re-insert it wherever it's used, not automatic template-wide sync.
model ClauseLibraryItem {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  title       String
  body        String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId])
}

// Answers from the pre-signup onboarding screens. Captured client-side and
// attached here right after the workspace is created (both the
// email/password and Google sign-up paths write this) — this is the raw
// material for building an ideal-customer profile over time, viewed in the
// admin panel.
model OnboardingProfile {
  id             String   @id @default(cuid())
  workspaceId    String   @unique
  workspace      Workspace @relation(fields: [workspaceId], references: [id])
  role           String // Q1: what best describes you
  callVolume     String // Q3: sales calls per month
  handoff        String // Q4: what happens after a prospect says yes
  biggestProblem String // Q5: biggest problem
  createdAt      DateTime @default(now())
}

model User {
  id              String    @id @default(cuid())
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id])
  name            String
  email           String    @unique
  passwordHash    String? // null for accounts created via Google sign-in
  emailVerifiedAt DateTime? // set immediately for Google sign-ins (already verified); via emailed link for credentials sign-ups
  createdAt       DateTime  @default(now())

  // SCIM provisioning (Okta/Azure AD/Entra pushing user lifecycle events).
  // scimExternalId is the IdP's own id for this person, kept so a later
  // SCIM call can look them up by an id the IdP already knows rather than
  // by email. deactivatedAt is SCIM's "active: false" — a soft block on
  // login, not a delete: whoever's HR system fired this can just as
  // easily reverse it, and their deal/audit history shouldn't disappear
  // just because they left.
  scimExternalId String?
  deactivatedAt  DateTime?

  // Nullable so nothing breaks for a user created before roles existed —
  // in practice the migration backfills every existing user onto their
  // workspace's auto-created Owner role, so this is really only ever null
  // in the instant between a teammate being invited and someone assigning
  // them a role.
  roleId String?
  role   Role?   @relation(fields: [roleId], references: [id])

  // Which Team this person is on — see the Team model doc comment. Nullable
  // for the same reason roleId is: nothing backfills it, a workspace that
  // never sets up teams just never has anyone on one.
  teamId String?
  team   Team?   @relation(fields: [teamId], references: [id], onDelete: SetNull)

  contractApprovalsDecided ContractApproval[]
  approvalsDecidedOnBehalfOf ContractApproval[] @relation("ApprovalDecidedOnBehalfOf")
  lockedTemplates          ContractTemplate[]
  ownedDeals               Deal[]

  // "While I'm out, X can approve on my behalf" — see ApprovalDelegate.
  // Both directions named since a person can appear as either delegator or
  // delegate across different rows, sometimes both at once.
  delegationsGiven    ApprovalDelegate[] @relation("DelegationFrom")
  delegationsReceived ApprovalDelegate[] @relation("DelegationTo")

  // twoFactorSecret is set as soon as setup starts (QR shown) but
  // twoFactorEnabled only flips to true once the user proves they can
  // generate a valid code — an unconfirmed secret can't be used to log in.
  twoFactorEnabled     Boolean  @default(false)
  twoFactorSecret      String?
  twoFactorBackupCodes String? // JSON array of {hash, usedAt} — same SHA-256-hash pattern as reset tokens

  resetTokens             PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  feedbackPosts           FeedbackPost[]
  feedbackVotes           FeedbackVote[]
}

// tokenHash stores SHA-256 of the raw token emailed to the user — same
// reasoning as PasswordResetToken, never store the usable value.
model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// tokenHash stores SHA-256 of the raw token emailed to the user — the raw
// value never touches the database, same reasoning as password hashing.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Client {
  id             String    @id @default(cuid())
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id])
  name           String
  company        String
  email          String?
  billingAddress String?
  createdAt      DateTime  @default(now())

  // A stable, bookmarkable link to this client's own portal (every
  // agreement they have with the workspace, in one place) — minted once,
  // lazily, the first time a contract is actually sent to them. Stored
  // plain, not hashed, the same trust model as a Contract's own id used
  // directly in /sign/[id]: an unguessable long-lived link, not a
  // short-lived single-use credential like the password-reset/local-capture
  // tokens, which is what actually needs hashing.
  portalToken String? @unique

  // Set once this client has been pushed to HubSpot as a Contact — lets
  // later syncs update that same record instead of creating a duplicate.
  hubspotContactId String?

  deals Deal[]
}

// A contract template's clauses are stored as JSON: an array of
// { title: string, body: string } objects. {placeholders} in body text
// are filled from the linked Deal's fields at contract-generation time.
model ContractTemplate {
  id                 String    @id @default(cuid())
  workspaceId        String
  workspace          Workspace @relation(fields: [workspaceId], references: [id])
  name               String
  description        String
  requiredFieldCount Int       @default(0)
  clauses            String // JSON string: [{title, body}]

  // Locking is the "legal approved this standard wording" gate — once
  // locked, editing/deleting requires canApproveTemplates, not just
  // canManageTemplates, so an individual rep can't quietly reword an
  // approved clause. lockedByUser is set-null on delete rather than
  // restricted — losing the "who locked it" attribution shouldn't block
  // removing a departed teammate.
  locked         Boolean   @default(false)
  lockedByUserId String?
  lockedByUser   User?     @relation(fields: [lockedByUserId], references: [id], onDelete: SetNull)
  lockedAt       DateTime?

  deals     Deal[]
  contracts Contract[]
}

model Deal {
  id          String            @id @default(cuid())
  workspaceId String
  workspace   Workspace         @relation(fields: [workspaceId], references: [id])
  clientId    String
  client      Client            @relation(fields: [clientId], references: [id])
  templateId  String?
  template    ContractTemplate? @relation(fields: [templateId], references: [id])

  // Whoever started this deal — the visibility boundary for a role without
  // canViewAllDeals. Nullable, and null-owner deals stay visible to
  // everyone: every deal that existed before this field did is null, and
  // there's no correct historical owner to backfill onto it. onDelete:
  // SetNull rather than Cascade — removing a teammate should never delete
  // their deals, just orphan the ownership.
  ownerId String?
  owner   User?   @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  // Defaults to the owner's team at creation time (see createDeal etc.),
  // editable afterward — this is what an ApprovalChain's teamId is matched
  // against. A deal with no team only matches chains that also have no
  // teamId set (or none at all — see resolveApprovalChain).
  teamId String?
  team   Team?   @relation(fields: [teamId], references: [id], onDelete: SetNull)

  service    String
  feeDisplay String
  status     String   @default("processing") // processing | missing_info | ready | pending_approval | changes_requested | sent | signed
  source     String   @default("manual") // zoom | meet | manual | upload | renewal
  callLength String?
  summary    String? // 2-3 sentence "what happened on this call", from the same extraction pass as the fields
  recallBotId String? @unique // set when a Recall.ai bot is capturing this call
  liveTranscript  String?   // accumulated utterances while a live call is in progress
  lastExtractedAt DateTime? // throttles re-extraction during a live call
  // Exactly what liveTranscript was the last time extraction ran — kept as
  // its own field (not derived) so the extraction prompt can send it as a
  // byte-identical, separately-cached block; only the text added since then
  // needs to be paid for at full price on the next pass.
  lastExtractedTranscript String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  // Set when a "this deal has been sitting untouched" nudge goes out —
  // cleared (via being older than updatedAt) the moment the deal is
  // actually touched again, so a resolved-then-stale-again deal can nudge
  // a second time instead of going quiet forever after one email.
  staleReminderSentAt DateTime?

  // Set once this deal has been pushed to HubSpot as a Deal object — lets
  // a later status change (sent, signed) update that same record.
  hubspotDealId String?

  fields       DealField[]
  contract     Contract?
  calls        Call[]
  fieldChanges DealFieldChange[]
  actionItems  ActionItem[]
}

// One row per recording session attached to a deal — a deal that started
// as a single call can pick up follow-up calls later (see
// startLocalCapture / continueLocalCapture) instead of always spawning a
// new deal. Deal.liveTranscript / lastExtractedTranscript are untouched by
// this — they stay the running input to extraction exactly as before; Call
// exists purely to let the UI show "here's what was said, call by call"
// (the negotiation timeline) without re-deriving it from one giant string.
model Call {
  id         String    @id @default(cuid())
  dealId     String
  deal       Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  transcript String    @default("")
  source     String // local | upload
  startedAt  DateTime  @default(now())
  endedAt    DateTime?

  localCaptureTokens LocalCaptureToken[]
  fieldChanges       DealFieldChange[]
  actionItems        ActionItem[]

  @@index([dealId])
}

// A commitment made on a call that isn't a deal term — "I'll send the
// proposal by Friday", "you need to sign off on the creative brief" — the
// kind of thing that currently just evaporates once the call ends. Extracted
// once, right when a call finishes (see extractActionItems), from that
// call's own transcript — never re-derived on later passes, so there's no
// risk of the same commitment reappearing as a duplicate.
model ActionItem {
  id          String    @id @default(cuid())
  dealId      String
  deal        Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  callId      String?
  call        Call?     @relation(fields: [callId], references: [id], onDelete: SetNull)
  description String
  ownerType   String // team | client — who owes this, not a specific named person
  dueDate     DateTime?
  status      String    @default("open") // open | done
  sourceQuote String?
  doneAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([dealId])
}

// One row per time a field's value actually changed after already having a
// real value — first-time extraction (missing -> found) isn't a "change",
// so this only fires when a later pass or a manual edit overwrites a value
// that was already something. Powers the "Fee: €2,000 -> €2,500" trail on
// the deal page; doesn't feed extraction itself in any way.
model DealFieldChange {
  id          String   @id @default(cuid())
  dealId      String
  deal        Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  fieldKey    String
  oldValue    String?
  newValue    String?
  changedBy   String // extraction | manual
  callId      String?
  call        Call?    @relation(fields: [callId], references: [id], onDelete: SetNull)
  sourceQuote String?
  changedAt   DateTime @default(now())

  @@index([dealId, fieldKey])
}

// One row per deal-term shown in the Deal Detail screen — mirrors the
// "field wrapper" pattern from the product spec: value + provenance,
// not a bare value, so Missing Info and source-quote grounding both work.
model DealField {
  id         String  @id @default(cuid())
  dealId     String
  deal       Deal    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  groupLabel String
  label      String
  fieldKey   String
  value      String?
  status     String  @default("extracted") // extracted | confirmed | missing | user_edited
  confidence Float?
  sourceQuote String?
  orderIndex Int     @default(0)

  @@unique([dealId, fieldKey])
}

model Contract {
  id         String            @id @default(cuid())
  dealId     String            @unique
  deal       Deal              @relation(fields: [dealId], references: [id])
  templateId String?
  template   ContractTemplate? @relation(fields: [templateId], references: [id])
  status     String            @default("draft") // draft | pending_approval | changes_requested | sent | partially_signed | signed | expired
  sentAt     DateTime?
  signedAt   DateTime?
  // signerName/signerIp/signatureImage are always the CLIENT's own
  // signature specifically (the original, single-signer fields — kept
  // exactly as-is so every existing piece built around them, audit trail,
  // dashboard, webhooks, HubSpot sync, keeps working unchanged). Additional
  // signers (a counter-signer on our own side, the client's legal/manager)
  // are ContractSigner rows below — most contracts have zero of those and
  // are functionally identical to before this existed.
  signerName String?
  signerIp   String?
  signatureImage String? // base64 PNG data URL, drawn on the sign page
  reminderSentAt DateTime? // set once the "still unsigned" nudge has gone out — cadence is workspace.reminderIntervalDays
  viewedAt   DateTime? // first time the client actually opened the sign page
  // Computed at send time from workspace.signingExpiryDays (sentAt + that
  // many days) — null when the workspace has no expiry configured, same
  // as the original never-expires behavior.
  expiresAt  DateTime?
  createdAt  DateTime          @default(now())

  // Comma-separated emails that get a copy of the contract email (sent AND
  // resent) but never sign anything — DocuSign calls these "CC recipients".
  ccEmails String?

  // "sealme" (default): SealMe's own /sign/[id] flow, everything already
  // built. "docusign": "Send to client" instead creates and sends a
  // DocuSign envelope for this contract's PDF — the client and any
  // ContractSigner rows sign entirely on DocuSign's own site, our
  // /sign/[id] and /countersign pages are never used for this contract.
  // Chosen per-contract on the Send page (only offered once the workspace
  // has connected DocuSign).
  deliveryMethod    String  @default("sealme")
  docusignEnvelopeId String?

  signers ContractSigner[]

  // Populated by a small Claude extraction pass right after signing, read
  // from the final filled clause text (the most reliable source — it's the
  // exact legal language, not a template placeholder). Null when the terms
  // didn't state a fixed end date (e.g. an ongoing engagement with no term).
  renewalDate           DateTime?
  autoRenews            Boolean   @default(false)
  renewalNote           String? // one short human sentence, e.g. "Renews monthly unless 30 days' notice given"
  renewalReminderSentAt DateTime? // set once the "renews/expires soon" nudge has gone out

  // The email a human composed on the Send page, held here while the
  // workspace's approval chain runs — sent for real, verbatim, the moment
  // the last step approves. Cleared once actually sent.
  pendingTo      String?
  pendingSubject String?
  pendingMessage String?

  approvals      ContractApproval[]
  clauseComments ClauseComment[]
}

// An ADDITIONAL signer beyond the client (order 0, implicit — that's still
// Contract.signerName/signatureImage above). Added at send time when a
// deal needs more than one signature — our own counter-signer, the
// client's legal/manager. Signs in `order` after the client, each notified
// only once it's their turn (DocuSign calls this routing order). A
// contract with zero of these behaves exactly like before this model
// existed.
model ContractSigner {
  id         String    @id @default(cuid())
  contractId String
  contract   Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  name       String
  email      String
  role       String // countersigner | cc-signer (free text label shown next to their name, e.g. "Legal")
  order      Int // 1, 2, 3... — 0 is implicitly the client, handled by the existing single-signer fields
  status     String    @default("pending") // pending | signed | declined
  token      String    @unique // this signer's own unguessable link credential — /sign/[contractId]/countersign/[token]
  signatureImage String?
  signerIp   String?
  declinedReason String?
  signedAt   DateTime?
  notifiedAt DateTime? // when it became their turn and we emailed their link
  createdAt  DateTime  @default(now())

  @@unique([contractId, order])
  @@index([contractId])
}

// A client's request to change a specific clause, left on the public sign
// page before they've signed — the "no way to negotiate, just sign-or-not"
// gap. Reuses the existing changes_requested status (same one an internal
// approval rejection sets) rather than adding a new one, so the contract
// page's "Send again" flow already just works. Auto-resolved (not deleted —
// kept as part of the record) the next time this contract is actually sent
// again, on the assumption the new version addresses it.
model ClauseComment {
  id          String   @id @default(cuid())
  contractId  String
  contract    Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  clauseTitle String
  comment     String
  fromName    String // whatever name the client typed in, or "The client" if left blank
  resolved    Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([contractId])
}

// A workspace-defined role — e.g. "Legal", "Finance", "Manager", or
// whatever a given company actually calls its own teams. Two jobs at once:
// (1) gates general app permissions below, (2) can be a step in an
// ApprovalStep chain, where "the Legal role approves" rather than one named
// person, so it still works if that specific person is out.
//
// Every workspace gets exactly one isOwner role, created alongside it —
// full permissions, can't be deleted, exists so there's always at least one
// person who can manage the workspace even if every custom role gets
// deleted.
model Role {
  id                  String    @id @default(cuid())
  workspaceId         String
  workspace           Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name                String
  isOwner             Boolean   @default(false)
  canManageWorkspace  Boolean   @default(false) // settings, sender domain, logo, workspace name
  canManageTeam       Boolean   @default(false) // invite/remove teammates, create/edit/delete roles, assign roles
  canManageTemplates  Boolean   @default(false) // create/edit/delete UNLOCKED contract templates
  canApproveContracts Boolean   @default(false) // eligible to be a step in an approval chain
  canApproveTemplates Boolean   @default(false) // lock/unlock templates, and edit/delete a locked one — the "legal approved this wording" gate
  canViewAllDeals     Boolean   @default(false) // see every deal/client in the workspace, not just ones this user started — a rep without it only sees their own (plus any deal with no owner)
  createdAt           DateTime  @default(now())

  users         User[]
  approvalSteps ApprovalStep[]
  approvals     ContractApproval[]

  @@unique([workspaceId, name])
}

// One workspace can have several of these — "Default", "EMEA >€50k",
// "US Standard" — instead of a single global chain. teamId/minDealValue are
// match conditions: null means "matches anything" on that axis. When a
// contract needs approval, every chain in the workspace is checked in
// `order`, and the FIRST one whose conditions both match wins — see
// resolveApprovalChain. Put more specific chains (a team, a value floor,
// or both) before a catch-all, or a catch-all will shadow them. A contract
// already mid-approval keeps its own ContractApproval snapshot, so editing
// chains never rewrites history for deals already in flight.
model ApprovalChain {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String

  teamId       String? // null = matches deals on any team (or no team)
  team         Team?   @relation(fields: [teamId], references: [id], onDelete: SetNull)
  minDealValue Float? // null = no floor — matches any deal value

  order     Int // evaluation priority: lower is checked first
  createdAt DateTime @default(now())

  steps ApprovalStep[]

  @@unique([workspaceId, order])
}

model ApprovalStep {
  id        String        @id @default(cuid())
  chainId   String
  chain     ApprovalChain @relation(fields: [chainId], references: [id], onDelete: Cascade)
  roleId    String
  role      Role          @relation(fields: [roleId], references: [id], onDelete: Cascade)
  order     Int
  createdAt DateTime      @default(now())

  @@unique([chainId, order])
}

// One row per approval step, per contract — a snapshot taken from whichever
// ApprovalChain resolved for this deal the moment it entered
// pending_approval. Anyone currently holding roleId can act on it (not one
// named person, and see ApprovalDelegate for "act on X's behalf while
// they're out"), but only once every lower-order step for the same
// contract is already "approved".
model ContractApproval {
  id             String    @id @default(cuid())
  contractId     String
  contract       Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  roleId         String
  role           Role      @relation(fields: [roleId], references: [id])
  order          Int
  status         String    @default("pending") // pending | approved | rejected
  decidedByUserId String?
  decidedByUser   User?     @relation(fields: [decidedByUserId], references: [id])
  // Set only when decidedByUserId acted as a delegate rather than a direct
  // holder of `role` — who they were standing in for, for the audit trail.
  decidedOnBehalfOfUserId String?
  decidedOnBehalfOfUser   User?   @relation("ApprovalDecidedOnBehalfOf", fields: [decidedOnBehalfOfUserId], references: [id])
  note           String?
  decidedAt      DateTime?
  createdAt      DateTime  @default(now())

  @@unique([contractId, order])
}

// "While I'm on leave, X can approve on my behalf." Self-service: anyone
// can hand their own approval authority to a colleague (fromUserId is
// always the acting session user when created that way); canManageWorkspace
// admins can also set one up for someone else (HR covering an unplanned
// absence) or revoke any delegation. endsAt null means "until manually
// revoked" rather than a fixed trip length. Decision eligibility in
// decideApproval checks: does the current user hold the step's role
// directly, OR is there a delegation, active right now, from someone who
// does?
model ApprovalDelegate {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  fromUserId  String
  fromUser    User      @relation("DelegationFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId    String
  toUser      User      @relation("DelegationTo", fields: [toUserId], references: [id], onDelete: Cascade)
  startsAt    DateTime  @default(now())
  endsAt      DateTime? // null = open-ended, until revoked
  createdAt   DateTime  @default(now())

  @@index([fromUserId])
  @@index([toUserId])
}

model UpgradeRequest {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  note        String?
  status      String    @default("pending") // pending | resolved
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?
}

model CalendarEvent {
  id              String    @id @default(cuid())
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id])
  title           String
  clientName      String?
  startTime       DateTime
  durationMinutes Int       @default(30)
  platform        String    @default("zoom") // zoom | meet
  meetingUrl      String? // Zoom/Meet link — lets a bot be scheduled to auto-join at startTime
  linkedDealId    String?
  googleEventId   String?   @unique // set when synced from Google Calendar; null for manually-added events
}

// A simple hit-counter for rate limiting public, unauthenticated endpoints
// (signup, login, password reset) — one row per attempt, counted within a
// sliding window. Rows are cheap and short-lived by nature of the check
// (old ones just stop counting), no cleanup job needed yet.
model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

// Short-lived, single-use token minted (server-side, while the user is
// authenticated in the desktop app's webview) so the native Rust process can
// upload a locally-recorded call straight to the transcribe endpoint without
// ever holding a session cookie or an API key of its own — same hashed-token
// pattern as password reset / email verification.
model LocalCaptureToken {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // dealId is denormalized (also reachable via call.dealId) purely so the
  // transcribe endpoint's hot path doesn't need an extra join — a deal can
  // now have more than one call, so this is no longer unique on its own;
  // callId is the actual one-token-per-recording-session key.
  dealId      String
  callId      String    @unique
  call        Call      @relation(fields: [callId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([workspaceId])
  @@index([dealId])
}

// Public, product-wide feature-request board — deliberately NOT scoped by
// workspaceId. Every other model in this schema is tenant-isolated because
// it holds one workspace's business data; this one is meant to be shared
// across all of SealMe's customers, same as Canny/Frill-style boards, so
// everyone sees and votes on the same list. Don't copy the workspaceId
// pattern here without re-reading this comment.
model FeedbackPost {
  id          String   @id @default(cuid())
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
  title       String
  description String
  status      String   @default("open") // open | planned | in_progress | done | closed
  createdAt   DateTime @default(now())

  votes FeedbackVote[]
}

model FeedbackVote {
  id        String       @id @default(cuid())
  postId    String
  post      FeedbackPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@unique([postId, userId])
}

// Security-relevant event trail — logins, sends, signatures, plan/team
// changes. workspaceId is nullable because a few events (e.g. a failed
// login for an email that doesn't exist) have no workspace to attach to
// yet. actorEmail is denormalized so entries stay readable even if the
// user is later removed.
model AuditLog {
  id          String    @id @default(cuid())
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id])
  actorEmail  String?
  action      String
  targetType  String?
  targetId    String?
  metadata    String?
  ip          String?
  createdAt   DateTime  @default(now())

  @@index([workspaceId, createdAt])
  @@index([action, createdAt])
}

// A credential for the public REST API (/api/v1/*) — a customer's own IT/
// integration team authenticates their own systems with this, the same way
// scimTokenHash lets an IdP authenticate. Hashed the same way (SHA-256, raw
// value shown exactly once at generation). keyPrefix is the first few
// characters of the raw key, kept in plaintext purely so the list in
// Settings can show "sk_live_a1b2••••" instead of nothing at all — it's not
// sensitive on its own (a prefix can't authenticate anything).
model ApiKey {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String // whatever the admin called it, e.g. "Salesforce sync"
  keyPrefix   String
  keyHash     String    @unique
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?

  @@index([workspaceId])
}

// A customer-configured HTTP endpoint that gets POSTed a JSON payload when
// one of `events` happens in this workspace — see src/lib/webhooks.ts for
// the event list and delivery/signing. secret is stored plain (consistent
// with every other long-lived credential in this schema that the customer
// needs to keep re-reading, like ssoClientSecret — not a one-time reveal
// like keyHash/scimTokenHash above, since they need it forever to verify
// each delivery's signature). events is a JSON string array, same pattern
// as ContractTemplate.clauses.
model WebhookEndpoint {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  url         String
  secret      String
  events      String // JSON string[], e.g. ["deal.created","contract.signed"]
  enabled     Boolean   @default(true)
  createdAt   DateTime  @default(now())

  deliveries WebhookDelivery[]

  @@index([workspaceId])
}

// A log line per delivery attempt, purely for the admin to debug "why
// didn't my webhook fire" from Settings — not itself retried automatically.
// responseStatus null means the request itself failed (DNS, timeout,
// connection refused) rather than the endpoint responding with an error
// code.
model WebhookDelivery {
  id             String          @id @default(cuid())
  endpointId     String
  endpoint       WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  event          String
  responseStatus Int?
  error          String?
  createdAt      DateTime        @default(now())

  @@index([endpointId, createdAt])
}
