{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "remote": {
    "urls": ["https://app.sealme.net/*"]
  },
  "permissions": [
    "core:default",
    "opener:default",
    "allow-start-local-capture",
    "allow-is-local-capturing",
    "allow-discard-local-capture",
    "allow-stop-local-capture-and-upload"
  ]
}
