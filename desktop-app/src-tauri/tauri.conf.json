{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SealMe",
  "version": "0.1.0",
  "identifier": "net.sealme.app",
  "build": {},
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "SealMe",
        "url": "https://app.sealme.net",
        "width": 1320,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "backgroundColor": "#f5f5f7"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
