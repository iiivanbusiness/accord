<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Required for any Mac App Store build — sandboxed apps get no
	     filesystem/network/device access beyond what's listed here. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>

	<!-- The window loads https://app.sealme.net, and upload_chunk() in
	     lib.rs posts recorded audio to it over reqwest — both go through
	     this, sandboxed or not. -->
	<key>com.apple.security.network.client</key>
	<true/>

	<!-- audio.rs's ScreenCaptureKit bridge captures the mic side of a call.
	     Screen/system-audio capture itself isn't gated by a sandbox
	     entitlement (macOS handles that via the Screen Recording TCC
	     prompt), but the mic tap needs this one. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>

	<!-- Only needed because we sign manually (raw `codesign`, no Xcode
	     managed signing) — Xcode would inject these automatically to match
	     the provisioning profile. Without them, the signed binary's
	     entitlements don't carry the same app/team identifier the profile
	     embeds, which Transporter rejects ("missing an application
	     identifier but has an application identifier in the provisioning
	     profile", error 90886). Tied to this specific Apple Developer
	     account/Team ID (Y6NYKGZKY8) — update if the account ever changes. -->
	<key>com.apple.application-identifier</key>
	<string>Y6NYKGZKY8.net.sealme.desktop</string>
	<key>com.apple.developer.team-identifier</key>
	<string>Y6NYKGZKY8</string>
</dict>
</plist>
